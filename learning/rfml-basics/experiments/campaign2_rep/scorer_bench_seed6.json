    "frames_test": 10,
    "fp_devices": 10,
    "fp_frames": 300,
    "epochs": 25,
    "patience": 5
  },
  "seed": 6,
  "split": "device-level; one CE model per seed with five post-hoc scorers and three Objectosphere arms; thresholds from known val-calib frames; unknown test frames (64QAM, 4PAM) influence no fit, selection or threshold",
  "known_classes": [
    "BPSK",
    "QPSK",
    "8PSK",
    "16QAM"
  ],
  "aux_outlier_classes_train_only": [
    "16PSK",
    "8PAM"
  ],
  "unknown_classes_test_only": [
    "64QAM",
    "4PAM"
  ],
  "target_known_accept": 0.95,
  "objectosphere": {
    "xi": 10.0,
    "lam": 0.1
  },
  "mahalanobis_shrinkage": 0.1,
  "n_samples": 512,
